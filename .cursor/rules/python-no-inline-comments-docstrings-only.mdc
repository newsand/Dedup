// @Failure 400 {object} ErrorResponse
// @Failure 500 {object} ErrorResponse
// @Router /users [post]
func (h *UserHandler) CreateUserHandler(p_writer http.ResponseWriter, p_request *http.Request) {
	// handler implementation
}